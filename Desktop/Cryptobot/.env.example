# =====================[ TBX Trade Terminal ]=====================

# --- Core ---
PROJECT_NAME=TBX Trade Terminal
VERSION=1.0.0
DEBUG=true

# --- Security ---
SECRET_KEY=dev-secret-key-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
# REQUIRED in production. Generate once and never change:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://tbx:tbx@localhost:5432/tbx
DATABASE_URL_SYNC=postgresql://tbx:tbx@localhost:5432/tbx

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Telegram ---
TELEGRAM_TOKEN=your-telegram-bot-token
BOT_USERNAME=your_bot_username

# --- DeepSeek AI ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# --- YooKassa ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_ENABLED=false

# --- Server ---
PORT=8000
